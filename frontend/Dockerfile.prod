# Production image: static build served by nginx, which also proxies /api/ to
# the backend (so the browser only ever talks to one origin, no CORS).
# The dev server image lives in ./Dockerfile (used by docker-compose).

# Build natively on the CI runner; the output is static so arch doesn't matter.
FROM --platform=$BUILDPLATFORM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# Relative base: nginx proxies /api/ to the backend (see nginx.conf.template).
ARG VITE_API_BASE=/api
ENV VITE_API_BASE=$VITE_API_BASE
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
# The image renders /etc/nginx/templates/*.template with env vars at startup.
ENV BACKEND_URL=http://backend:8080
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
